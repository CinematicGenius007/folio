{
  "name": "folio",
  "version": "0.1.1",
  "private": true,
  "description": "A fast, keyboard-first bookmark manager that sits on top of your browser's own bookmarks.",
  "keywords": [
    "bookmarks",
    "bookmark-manager",
    "browser-extension",
    "webextension",
    "chrome",
    "firefox",
    "zen",
    "local-first",
    "keyboard"
  ],
  "license": "MIT",
  "author": "Folio contributors <folio@cinematicgenius007.com>",
  "homepage": "https://folio.cinematicgenius007.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CinematicGenius007/folio.git"
  },
  "bugs": {
    "url": "https://github.com/CinematicGenius007/folio/issues",
    "email": "folio@cinematicgenius007.com"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "e2e:zen": "VITE_FOLIO_TEST=1 wxt build -b firefox && node e2e/zen-full.mjs && node e2e/zen-live.mjs",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm compile && pnpm test",
    "build:test": "VITE_FOLIO_TEST=1 wxt build",
    "build:test:firefox": "VITE_FOLIO_TEST=1 VITE_FOLIO_OPEN_PAGES=1 wxt build -b firefox",
    "e2e:chromium": "pnpm build:test && node e2e/chromium.e2e.mjs",
    "e2e:firefox": "pnpm build:test:firefox && node e2e/firefox.e2e.mjs",
    "screenshots": "pnpm build:test && node scripts/screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "zip:firefox": "wxt zip -b firefox",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.14.0",
    "playwright-core": "1.60.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
